# OAuth client ID from Google Cloud. This must match the Streamlit OIDC client ID.
GOOGLE_OAUTH_CLIENT_ID=

# Streamlit sends the Google ID token only to this configured API endpoint.
TRANSLATION_API_URL=http://127.0.0.1:8000

# NLLB is public; HF_TOKEN is optional and can be left empty.
HF_TOKEN=
TRANSLATOR_MODEL_ID=facebook/nllb-200-distilled-600M

# NLLB-200 distilled 600M runs comfortably on the 8 GB RTX 4060 Ti.
CUDA_VISIBLE_DEVICES=0
